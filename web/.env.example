# =============================================================================
#  環境変数のひな形
#
#  このファイルをコピーして .env.local を作り、各サービスの管理画面から
#  取得した値を入れてください。
#      cp .env.example .env.local
#
#  .env.local は .gitignore に含まれており、コミットされません。
# =============================================================================

# --- Supabase ---------------------------------------------------------------
# Supabase ダッシュボード → Project Settings → API から取得
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️ service_role キーは RLS を無視して全データにアクセスできる管理者キーです。
#    絶対に公開したり、NEXT_PUBLIC_ を付けたりしないでください。
SUPABASE_SERVICE_ROLE_KEY=

# --- 管理者 -----------------------------------------------------------------
# 管理画面にログインできる唯一のメールアドレス。ここに書いたアドレス以外は
# ログインリンクを受け取れません。予約通知の宛先にもなります。
ADMIN_EMAIL=

# --- サイトURL --------------------------------------------------------------
# 本番のURL（末尾のスラッシュなし）。メール本文のリンクとOGPに使われます。
# 例: https://example.com
NEXT_PUBLIC_SITE_URL=

# --- メール送信（Resend）----------------------------------------------------
# 未設定でも予約自体は動きますが、確認メールは送信されません。
RESEND_API_KEY=
# 送信元アドレス。Resend でドメイン認証を済ませたドメインを使ってください。
# 例: 予約確認 <noreply@example.com>
MAIL_FROM=

# --- ボット対策（Cloudflare Turnstile）--------------------------------------
# 未設定の場合、ボット判定は行われません（開発中は空のままで構いません）。
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
