# =============================================================================
#  環境変数のひな形（いまのコードが実際に読むものだけ）
#
#  ローカルで試すとき：このファイルをコピーして .env.local を作り、値を入れる。
#      cp .env.example .env.local
#  .env.local は .gitignore に含まれており、コミットされません。
#  本番（Cloudflare Pages）では、設定画面の「Environment variables」に同じ名前で入れる。
#
#  NEXT_PUBLIC_ の付いた値は、ビルドのときにサイトの中へ埋め込まれます（値を変えたら再ビルド）。
# =============================================================================

# --- Supabase（会員ページ）---------------------------------------------------
# Supabase ダッシュボード → Project Settings → API から取得。どちらも公開してよい値。
# 空のままなら、会員ページは「デモモード」（この端末の中にだけ保存）で動く。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️ service_role（secret）キーと、データベースのパスワードは、このサイトでは使いません。
#    どこにも入れないでください（RLS を無視して全データを読み書きできる鍵です）。

# --- サイトのURL -------------------------------------------------------------
# 本番のURL（末尾のスラッシュなし）。例: https://toneka.jp
NEXT_PUBLIC_SITE_URL=

# --- 公開前の設定 ------------------------------------------------------------
# 1 のあいだは、検索結果に出ない（robots / noindex）。公開するときに外す。
NEXT_PUBLIC_NOINDEX=1
